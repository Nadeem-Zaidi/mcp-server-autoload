# Copy to .env and adjust. All variables are optional.

# debug | info | warn | error   (default: info)
LOG_LEVEL=info

# Shown to MCP clients (default: mcp-server-autoload / 1.0.0)
MCP_SERVER_NAME=mcp-server-autoload
MCP_SERVER_VERSION=1.0.0

# Where compiled tool files are loaded from (default: dist/tools next to dist/index.js).
# Override this to point at a different directory of tools at runtime,
# e.g. a mounted volume in a container, without rebuilding the image.
# MCP_TOOLS_DIR=/app/dist/tools
