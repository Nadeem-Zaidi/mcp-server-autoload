{
  "name": "mcp-server-autoload",
  "version": "1.0.0",
  "description": "Production-ready MCP server with auto-discovered tools — drop a file in src/tools, get a tool.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-server-autoload": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "new-tool": "tsx scripts/new-tool.ts",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}